# Neon / Vercel Postgres ulanishlari (Vercel → Storage → Neon → .env.local tab'dan nusxa oling)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# MAJBURIY (kamida 16 belgi): openssl rand -hex 32. Bo'sh bo'lsa sessiya kaliti bazadan olinadi — zaxira usul, ishonchli emas.
AUTH_SECRET=""

# Admin Telegram username (@ belgisisiz) — "Adminga yozish" tugmalari uchun
NEXT_PUBLIC_ADMIN_TELEGRAM=""

# Faqat seed uchun (birinchi admin)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD=""

# Sayt manzili (xatlardagi havola uchun)
SITE_URL="https://ilmaviya.vercel.app"

# Login/parol xatlari uchun SMTP (ixtiyoriy). Gmail: smtp.gmail.com / 465 / gmail manzil / "App password"
# Resend: smtp.resend.com / 465 / resend / API kalit
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Videolar uchun Cloudflare R2 (yopiq bucket). Darsning video maydoniga: r2:kurs/nom.mp4
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; kalitlar: R2 -> Manage API tokens (Object Read & Write, faqat shu bucket)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
