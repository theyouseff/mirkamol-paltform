generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled ulanish (ilova uchun)
  directUrl = env("DATABASE_URL_UNPOOLED") // to'g'ridan-to'g'ri ulanish (db push / migratsiya uchun)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STUDENT") // ADMIN | CURATOR | STUDENT
  createdAt    DateTime @default(now())

  enrollments Enrollment[]
  orders      Order[]
  progress    LessonProgress[]
  watches     LessonWatch[]
  loginDays   LoginDay[]
  curatorCourses CuratorCourse[]
  dayNotes    DayNote[]
  chatMessages ChatMessage[]
  curatorChats ChatMessage[] @relation("ChatCurator")
  resets      PasswordReset[]
}

// Kurs muallifi (ekspert). Barcha to'lovlar egasining hisobiga tushadi — muallif bo'yicha hisobot uchun.
model Author {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String   @default("")
  description String   @default("")
  coverUrl    String   @default("")
  published   Boolean  @default(false)
  price       Int      @default(0) // so'mda; "O'quvchi qo'shish" formasida summa shundan to'ldiriladi
  createdAt   DateTime @default(now())

  authorId   String?
  author     Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Kursning o'z brendi (B variant): logotip, nom va asosiy rang
  brandName  String  @default("")
  logoUrl    String  @default("")
  brandColor String  @default("")

  modules     Module[]
  enrollments Enrollment[]
  orders      Order[]
  curators    CuratorCourse[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title       String
  description String   @default("")
  order       Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id       String    @id @default(cuid())
  moduleId String
  title    String
  content  String    @default("")
  videoUrl String    @default("")
  duration String    @default("") // masalan: "12:40" (ixtiyoriy)
  order    Int       @default(0)
  openAt   DateTime? // zapusk uchun: shu sanagacha yopiq
  module   Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]
  watches  LessonWatch[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id          String    @id @default(cuid())
  number      Int       @unique // Payme/Click uchun qisqa raqam
  userId      String
  courseId    String
  amount      Int
  status      String    @default("PENDING") // PENDING | PAID | CANCELED
  provider    String    @default("") // payme | click | manual | test
  utmSource   String    @default("")
  utmCampaign String    @default("")
  note        String    @default("") // masalan: "Karta orqali, skrinshot Telegramda"
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict) // to'lov yozuvlari kurs bilan birga o'chib ketmasin
}

model LessonProgress {
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// Video ko'rish analitikasi: o'quvchi har bir darsda qayergacha ko'rgani va qaysi soniyada to'xtagani (admin "Analitika" uchun).
model LessonWatch {
  userId    String
  lessonId  String
  position  Int      @default(0) // to'xtagan joyi, soniyada
  duration  Int      @default(0) // video uzunligi, soniyada
  watched   Int      @default(0) // haqiqatan ijro etilgan noyob soniyalar
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([updatedAt])
}

// O'quvchi platformaga kirgan kunlar (kabinetdagi kalendar uchun). day — Toshkent vaqti bo'yicha "2026-09-24".
model LoginDay {
  userId String
  day    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// Kuratorga biriktirilgan kurslar: kurator shu kurslardagi barcha o'quvchilarni ko'radi (kursga keyin yozilganlar ham avtomatik).
model CuratorCourse {
  curatorId String
  courseId  String
  createdAt DateTime @default(now())
  curator   User     @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([curatorId, courseId])
}

// Kurator o'quvchining kelmagan kuniga qo'ygan holat va sabab. status: SEEN (dars ko'rdi) | NOT_SEEN (dars ko'rmadi) | EXCUSED (sababli).
model DayNote {
  userId     String
  day        String // Toshkent vaqti bo'yicha "2026-09-24"
  status     String
  reason     String   @default("")
  authorName String   @default("")
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// O'quvchi bilan kurator chati: har bir (o'quvchi, kurator) juftligining alohida suhbati — kuratorlar bir-birining yozishmasini ko'rmaydi.
// authorRole: STUDENT | STAFF (kurator). readAt — xabarni qarshi tomon o'qigan vaqt. curatorId — suhbat qaysi kurator bilan.
model ChatMessage {
  id         String    @id @default(cuid())
  studentId  String
  curatorId  String? // faqat eski yozuvlarda bo'sh bo'lishi mumkin; yangilari doim to'ldiriladi
  authorId   String
  authorRole String
  authorName String
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curator    User?     @relation("ChatCurator", fields: [curatorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([curatorId, studentId, createdAt])
}

// Kirish va parol tiklash urinishlari (brute-force'dan himoya). key: "login:ip:email", "login:ip:1.2.3.4", "reset:email:a@b.c" ...
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Parolni o'zi tiklash: emailga yuboriladigan bir martalik havola. Bazada faqat token xeshi saqlanadi.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
